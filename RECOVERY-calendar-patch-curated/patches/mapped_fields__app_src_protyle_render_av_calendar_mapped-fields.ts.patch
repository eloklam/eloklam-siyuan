+/**
+ * Build cell update operation for a text/template field.
+ * Used for recurrence which supports both text and template cells.
+ */
+export const buildTextOrTemplateCellUpdate = (
+    avID: string,
+    event: ICalendarNormalizedEvent,
+    fieldID: string,
+    newValue: string,
+    oldValue: string,
+    fields: IAVColumn[],
+    allowTemplate = false,
+): ICellUpdateResult | null => {
+    const targetType = getFieldType(fieldID, fields);
+    if (targetType !== "text" && !(allowTemplate && targetType === "template")) {
+        return null;
+    }
+
+    const existingCell = findExistingCell(event, fieldID);
+
+    // For edits, we MUST have an existing cell with an ID
+    if (!existingCell?.id) {
+        console.warn(`[Calendar] No existing cell found for field ${fieldID}`);
+        return null;
+    }
+
+    const cellID = existingCell.id;
+
+    const oldCellValue: IAVCellValue = existingCell.value
+        ? JSON.parse(JSON.stringify(existingCell.value))
+        : {
+            type: targetType,
+            id: cellID,
+            keyID: fieldID,
+            ...(targetType === "template" ? {template: {content: oldValue}} : {text: {content: oldValue}}),
+        };
+
+    // Ensure required properties
+    oldCellValue.id = cellID;
+    if (!oldCellValue.keyID) oldCellValue.keyID = fieldID;
+    if (!oldCellValue.type) oldCellValue.type = targetType;
+
+    const newCellValue: IAVCellValue = {
+        ...(JSON.parse(JSON.stringify(oldCellValue))),
+        type: targetType,
+        id: cellID,
+        keyID: fieldID,
+    };
+
+    if (targetType === "template") {
+        newCellValue.template = {content: newValue};
+        delete newCellValue.text;
+    } else {
+        newCellValue.text = {content: newValue};
+        delete newCellValue.template;
+    }
+
+    return {
+        doOp: {
+            action: "updateAttrViewCell",
+            id: cellID,
+            avID,
+            keyID: fieldID,
+            rowID: event.id,
+            data: newCellValue,
+        },
+        undoOp: {
+            action: "updateAttrViewCell",
+            id: cellID,
+            avID,
+            keyID: fieldID,
+            rowID: event.id,
+            data: oldCellValue,
+        },
+    };
+};
+
